---
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
import { salon, menus, reviews, questions } from '../data/salon';
import '../styles/brand.css';
const title = "乃木坂のフェイシャルエステ｜M'amie esthetique studio（マミー）";
const description = '乃木坂駅3番出口から徒歩1分、六本木駅から徒歩5分。M\'amie esthetique studio（マミーエステティックスタジオ）は、東京都港区赤坂の完全予約制・女性専用フェイシャルエステサロンです。プラセンタ配合化粧品を使ったケア、メニュー、お客様の声、アクセスをご案内します。';
const canonicalUrl = new URL('/', Astro.site).href;
const socialImageUrl = new URL('/images/og/mamie-esthetique-studio.jpg', Astro.site).href;
const logoUrl = new URL('/images/brand/mamie-logo-original.jpg', Astro.site).href;
const businessId = `${canonicalUrl}#salon`;
const websiteId = `${canonicalUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const imageId = `${canonicalUrl}#primaryimage`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: canonicalUrl,
      name: salon.name,
      alternateName: 'マミーエステティックスタジオ',
      inLanguage: 'ja-JP',
      publisher: { '@id': businessId },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'ja-JP',
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': businessId },
      primaryImageOfPage: { '@id': imageId },
    },
    {
      '@type': 'ImageObject',
      '@id': imageId,
      url: socialImageUrl,
      contentUrl: socialImageUrl,
      width: 1200,
      height: 630,
      caption: 'M\'amie esthetique studioのフェイシャルケア',
    },
    {
      '@type': 'BeautySalon',
      '@id': businessId,
      name: salon.name,
      alternateName: 'マミーエステティックスタジオ',
      url: canonicalUrl,
      description,
      telephone: '+81-3-6906-5411',
      image: { '@id': imageId },
      logo: { '@type': 'ImageObject', url: logoUrl, width: 426, height: 86 },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '赤坂9-6-29 パシフィック乃木坂507',
        addressLocality: '港区',
        addressRegion: '東京都',
        postalCode: '107-0052',
        addressCountry: 'JP',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '11:00',
        closes: '19:00',
        description: '平日・土日祝とも11:00〜19:00。不定休・完全予約制・女性専用。',
      },
      hasMap: salon.links.map,
      sameAs: ['https://mamie-es.com/', salon.links.facebook],
      mainEntityOfPage: { '@id': webpageId },
    },
  ],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f3" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={salon.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="M'amie esthetique studioのフェイシャルケア" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="M'amie esthetique studioのフェイシャルケア" />
    <link rel="icon" type="image/svg+xml" href="/mamie-icon.svg" />
    <link rel="preload" as="image" href="/images/generated/hero.webp" imagesrcset="/images/generated/hero-mobile.webp 800w, /images/generated/hero.webp 1536w" imagesizes="(max-width: 760px) 100vw, 60vw" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <div id="top"></div>
    <Header />
    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-photo"><img src="/images/generated/hero.webp" srcset="/images/generated/hero-mobile.webp 800w, /images/generated/hero.webp 1536w" sizes="(max-width: 760px) 100vw, 60vw" width="1536" height="1024" alt="白いタオルに包まれ、顔まわりのケアを受ける女性" fetchpriority="high" /></div>
        <div class="hero-copy">
          <p class="hero-location"><span class="location-dot" aria-hidden="true"></span>乃木坂駅から徒歩1分</p>
          <h1 id="hero-title"><span>肌に向き合う、</span><span>わたしに戻る時間。</span></h1>
          <p class="hero-description">あわただしい毎日に、<br />肌と心をいたわる、ひとときを。</p>
          <a href={salon.links.contact} class="button button-dark hero-button">ご予約・お問い合わせ <Arrow /></a>
          <p class="hero-conditions">完全予約制 <span></span> 女性専用 <span></span> 1席のサロン</p>
        </div>
        <a href="#about" class="hero-next" aria-label="サロンについて読む"><span>サロンを知る</span><span class="next-line" aria-hidden="true"></span></a>
      </section>

      <section id="about" class="about section-space" aria-labelledby="about-title">
        <div class="container about-layout">
          <div class="section-caption reveal"><span class="caption-line"></span>サロンについて</div>
          <div class="about-copy reveal"><h2 id="about-title">ひと席だから、<br />大切にできる時間がある。</h2><p>M'amie esthetique studio<br />（マミーエステティックスタジオ）は、<br class="desktop-break" />乃木坂駅から徒歩1分。<br />東京都港区赤坂にある、<br class="desktop-break" />小さなフェイシャルエステサロンです。</p><p>肌のことを話したり、そっと目を閉じたり。<br class="desktop-break" />ここでは、日々の忙しさを少しだけ手放して。</p><p>一人ひとりの肌に向き合うお手入れと、<br class="desktop-break" />ほっとできる時間をお届けします。</p></div>
          <div class="about-aside reveal"><div class="salon-photo image-frame"><img src="/images/original/salon.webp" width="550" height="413" alt="M'amie esthetique studioの落ち着いたサロン内" loading="lazy" /></div><p>完全予約制・女性専用。<br />ひと席の、プライベートなサロンです。</p></div>
          <svg class="about-curve" viewBox="0 0 600 340" fill="none" aria-hidden="true"><path d="M2 310C130 320 80 30 270 40S440 270 595 4" stroke="currentColor" stroke-width=".8" /></svg>
        </div>
      </section>

      <section id="care" class="care" aria-labelledby="care-title">
        <div class="care-image"><img src="/images/generated/care.webp" width="1122" height="1402" alt="頬やフェイスラインを手でやさしくケアする様子" loading="lazy" /></div>
        <div class="care-content"><div class="section-caption reveal"><span class="caption-line"></span>お手入れへのこだわり</div><h2 id="care-title" class="reveal">触れる。整える。<br />肌を、いたわる。</h2>
          <div class="care-points">
            <article class="care-point reveal"><h3>肌の声を聞くことから。</h3><p>肌の状態や気になることを、カウンセリングでお聞かせください。お手入れのはじまりは、あなたの肌を知ることから。</p></article>
            <article class="care-point reveal"><h3>手から伝わる、心地よさ。</h3><p>お顔から首、肩、デコルテへ。ハンドマッサージを取り入れたケアで、ゆったりとした時間をお過ごしいただけます。</p></article>
            <article class="care-point reveal"><h3>使うものにも、こだわりを。</h3><p>プラセンタ配合の化粧品や美容液を、お手入れに使用。サロンでのケアから毎日のホームケアまでご紹介します。</p></article>
          </div>
        </div>
      </section>

      <section id="menu" class="menu-section section-space" aria-labelledby="menu-title"><div class="container">
        <div class="section-heading"><div><div class="section-caption reveal"><span class="caption-line"></span>メニューのご案内</div><h2 id="menu-title" class="reveal">今日の肌に、<br />ちょうどいいお手入れを。</h2></div><p class="section-intro reveal">基本のケアから、ゆっくり過ごすコースまで。<br />肌のこと、気になることからお選びください。</p></div>
        <div class="menu-list">{menus.map((menu) => <a class="menu-row reveal" href={salon.links.menu}><h3>{menu.name}</h3><p>{menu.text}</p><span class="round-arrow"><Arrow /></span></a>)}<a class="menu-row body-menu reveal" href={salon.links.menu}><h3>ボディメニュー</h3><p>アロマオイルトリートメント、背中のケアもご用意しています。</p><span class="round-arrow"><Arrow /></span></a></div>
        <div class="menu-bottom reveal"><p>各コースの詳しい内容と料金は、<br class="mobile-break" />公式サイトにてご覧いただけます。</p><a class="text-link" href={salon.links.menu}>詳しいメニュー・料金表を見る <Arrow /></a></div>
      </div></section>

      <section class="first-visit" aria-labelledby="visit-title"><div class="container visit-layout">
        <div class="reveal"><div class="section-caption"><span class="caption-line"></span>初めての方へ</div><h2 id="visit-title">ご来店の流れ</h2></div>
        <ol class="visit-steps"><li class="reveal"><span class="step-dot" aria-hidden="true"></span><h3>ご予約・ご相談</h3><p>お電話、または公式サイトの<br />お問い合わせページから。</p></li><li class="reveal"><span class="step-dot" aria-hidden="true"></span><h3>カウンセリング</h3><p>肌の状態や、ご希望の<br />お手入れをお伺いします。</p></li><li class="reveal"><span class="step-dot" aria-hidden="true"></span><h3>お手入れ</h3><p>選んだコースに合わせて、<br />ゆっくりと施術を。</p></li><li class="reveal"><span class="step-dot" aria-hidden="true"></span><h3>施術後のご案内</h3><p>お手入れ後の肌や、<br />ホームケアについて。</p></li></ol>
      </div></section>

      <section id="voices" class="voices section-space" aria-labelledby="voices-title"><div class="container voices-layout">
        <div class="voices-heading reveal"><div class="section-caption"><span class="caption-line"></span>お客様の声</div><h2 id="voices-title">ここで過ごした、<br />ひとときから。</h2><p>サロンに寄せられたお声を、<br />公式サイトよりご紹介します。</p><a href={salon.links.voices} class="text-link">ほかのお客様の声を見る <Arrow /></a></div>
        <div class="reviews">{reviews.map((review) => <figure class="review reveal"><blockquote><p>{review.text}</p></blockquote><figcaption><span>{review.author}<span class="review-age">{review.age}</span></span><span><time datetime={review.isoDate}>{review.date}</time><a href={review.source}>掲載元・抜粋 <span aria-hidden="true">↗</span></a></span></figcaption></figure>)}</div>
      </div></section>

      <section class="shopping section-space" aria-labelledby="shopping-title"><div class="container shopping-layout">
        <div class="shopping-image image-frame reveal"><img src="/images/generated/homecare.webp" width="1448" height="1086" alt="ラ・プレシアのクレンジングオイルとクリーム" loading="lazy" /></div>
        <div class="shopping-copy reveal"><div class="section-caption"><span class="caption-line"></span>ホームケア</div><h2 id="shopping-title">サロンのその先も、<br />肌を大切に。</h2><p>毎日の小さなお手入れも、<br />自分をいたわる、大切な時間。</p><p>サロンで使用しているスキンケア商品を、<br class="desktop-break" />公式サイトのショッピングページでご紹介しています。</p><a class="text-link" href={salon.links.shopping}>ショッピングを見る <Arrow /></a></div>
      </div></section>

      <section class="faq-section" aria-labelledby="faq-title"><div class="container faq-layout">
        <div class="reveal"><div class="section-caption"><span class="caption-line"></span>ご来店の前に</div><h2 id="faq-title">よくあるご質問</h2></div><div class="faq-list reveal">{questions.map((item) => <details><summary>{item.question}<span class="plus" aria-hidden="true"></span></summary><div class="faq-answer"><p>{item.answer}</p><a href={item.link}>{item.label} <span aria-hidden="true">↗</span></a></div></details>)}</div>
      </div></section>

      <section id="access" class="access section-space" aria-labelledby="access-title"><div class="container">
        <div class="section-caption reveal"><span class="caption-line"></span>アクセス</div>
        <div class="access-layout"><div class="access-copy reveal"><h2 id="access-title">乃木坂の街で、<br />お待ちしています。</h2><p class="access-lead">乃木坂駅3番出口から徒歩1分。<br />六本木からも歩いてお越しいただけます。</p><dl class="salon-details"><div><dt>所在地</dt><dd>{salon.address}<br />{salon.building}</dd></div><div><dt>営業時間</dt><dd><span class="numeral">11:00–19:00</span>（平日・土日祝）<br />不定休／完全予約制・女性専用</dd></div><div><dt>電話番号</dt><dd><a class="numeral" href={salon.phoneHref}>{salon.phone}</a></dd></div></dl><a href={salon.links.map} target="_blank" rel="noopener noreferrer" class="text-link">Google マップで開く <Arrow diagonal /></a></div>
        <div class="access-directions reveal"><div class="station-emblem" aria-hidden="true"><span>乃木坂</span><span class="station-ring"></span></div><div class="station-row"><div><p>東京メトロ 千代田線</p><h3>乃木坂駅 <span>3番出口</span></h3></div><p class="walk">徒歩 <strong>1</strong> 分</p></div><div class="station-row"><div><p>都営大江戸線</p><h3>六本木駅 <span>8番出口</span></h3></div><p class="walk">徒歩 <strong>5</strong> 分</p></div><div class="station-row"><div><p>東京メトロ 日比谷線</p><h3>六本木駅 <span>4番出口</span></h3></div><p class="walk">徒歩 <strong>5</strong> 分</p></div><p class="arrival-note">パシフィック乃木坂の507号室へお越しください。</p></div></div>
      </div></section>

      <section class="contact-section" aria-labelledby="contact-title"><div class="container contact-layout"><div class="reveal"><p class="contact-eyebrow">完全予約制・女性専用</p><h2 id="contact-title">次のひとときは、<br />あなたのために。</h2></div><div class="contact-actions reveal"><a href={salon.links.contact} class="button button-dark">ご予約・お問い合わせ <Arrow /></a><a href={salon.phoneHref} class="contact-phone">{salon.phone}<span>お電話でのご予約・ご相談</span></a><p>受付時間 11:00–19:00 ／ 不定休</p></div></div><svg class="contact-curve" viewBox="0 0 1000 400" fill="none" aria-hidden="true"><path d="M-20 380C160 420 150 80 400 170S750 450 1020 10" stroke="currentColor" stroke-width="1" /></svg></section>
    </main>
    <footer class="site-footer container"><div class="footer-main"><div><Logo footer /><p>{salon.address}<br />{salon.building}</p></div><nav aria-label="フッターナビゲーション"><a href={salon.links.menu}>メニュー・料金表</a><a href={salon.links.shopping}>ショッピング</a><a href={salon.links.contact}>ご予約・お問い合わせ</a><a href={salon.links.facebook} target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a></nav></div><div class="footer-bottom"><small>© {new Date().getFullYear()} M'amie esthetique studio</small><a href={salon.links.contact}>プライバシーポリシー</a><a class="back-top" href="#top">ページの先頭へ ↑</a></div></footer>
    <div class="mobile-actions"><a href={salon.phoneHref}><svg width="16" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 2L2 4C2 11 9 18 16 18L18 15L13 12L11 14C8 13 6 11 6 8L8 6L5 2Z" stroke="currentColor" stroke-linejoin="round" /></svg>電話する</a><a href={salon.links.contact}>ご予約・お問い合わせ <Arrow /></a></div>
    <script>import { initSite } from '../scripts/site'; initSite();</script>
  </body>
</html>

